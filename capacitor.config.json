{
  "appId": "com.beno74.shapescraper",
  "appName": "Shapescraper",
  "webDir": "www",
  "backgroundColor": "#9dbef2",
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "launchFadeOutDuration": 0
    }
  },
  "experimental": {
    "ios": {
      "spm": {
        "swiftToolsVersion": "6.1",
        "packageOptions": {
          "@capacitor-firebase/analytics": {
            "symlink": true
          }
        },
        "packageTraits": {
          "@capacitor-firebase/analytics": [
            "AnalyticsWithoutAdIdSupport"
          ]
        }
      }
    }
  }
}
